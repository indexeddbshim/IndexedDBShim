{
  "compilerOptions": {
    "lib": ["DOM", "es2023"],
    "types": ["node", "websql"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2017"
  },
  // , "test-support/**/*.js", "tests-mocha/**/*.js", "tests-polyfill/**/*.js"
  "include": ["src/**/*.js", "typings/shimIndexedDB.d.ts"],
  "exclude": ["node_modules", "web-platform-tests", "test-support/js"]
}
